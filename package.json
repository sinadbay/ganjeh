{
  "name": "ganjeh",
  "version": "0.1.0",
  "description": "A command-line password vault: encrypt and retrieve local credentials with a passphrase.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinadbay/ganjeh.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "vault": "dist/bin/vault.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist && chmod +x dist/bin/vault.js",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
